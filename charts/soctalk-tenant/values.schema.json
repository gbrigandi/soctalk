{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soctalk/soctalk/charts/soctalk-tenant/values.schema.json",
  "title": "SocTalk Tenant Chart Values",
  "description": "Validation schema for soctalk-tenant Helm chart values (rendered by SocTalk controller from per-tenant config).",
  "type": "object",
  "required": [
    "tenant",
    "branding",
    "llm",
    "components",
    "networkPolicies",
    "resourceQuota",
    "limitRange",
    "adapter",
    "runsWorker"
  ],
  "additionalProperties": false,
  "properties": {
    "wazuh": {
      "type": "object",
      "additionalProperties": true,
      "description": "Passthrough values for the bundled wazuh subchart (only rendered when components.wazuh.enabled is true). Structure is defined by charts/wazuh/values.yaml, not this schema."
    },
    "linuxep": {
      "type": "object",
      "additionalProperties": true,
      "description": "Passthrough values for the bundled linux-ep subchart (only rendered when components.linuxep.enabled is true). Structure is defined by charts/linux-ep/values.yaml, not this schema."
    },
    "linux-ep": {
      "type": "object",
      "additionalProperties": true,
      "description": "Helm-injected defaults of the linux-ep dependency under its CHART NAME (the alias 'linuxep' above carries the real values). helm >= 3.15 validates the fully coalesced value tree, which includes this key, so the strict root schema must admit it or every render fails on a stock newer helm."
    },
    "tenant": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "msspId",
        "installId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "msspId": {
          "type": "string",
          "format": "uuid"
        },
        "installId": {
          "type": "string",
          "format": "uuid"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appName": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string"
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{3,8}$"
        },
        "secondaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{3,8}$"
        },
        "favicon": {
          "type": "string"
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "provider",
        "baseUrl",
        "model",
        "apiKeyRef"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "provider",
              "engine"
            ],
            "properties": {
              "provider": {
                "const": "anthropic"
              },
              "engine": {
                "enum": [
                  "openai_compatible",
                  "vllm",
                  "sglang"
                ]
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "engine"
            ],
            "properties": {
              "engine": {
                "enum": [
                  "openai_compatible",
                  "vllm",
                  "sglang"
                ]
              }
            },
            "anyOf": [
              {
                "not": {
                  "required": [
                    "baseUrl"
                  ]
                }
              },
              {
                "required": [
                  "baseUrl"
                ],
                "properties": {
                  "baseUrl": {
                    "pattern": "^\\s*(?:$|[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^@/?#\\s]+@)?api\\.(?:openai|anthropic)\\.com(?::[0-9]+)?(?:[/\\?#].*)?)\\s*$"
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai-compatible",
            "anthropic"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Primary LLM base URL. For served/gateway engines, the schema rejects common hosted OpenAI/Anthropic API forms after trimming whitespace as a fail-fast approximation; the API/Python invariant is authoritative."
        },
        "temperature": {
          "description": "Tenant-global default sampling temperature for the router/supervisor tier. Rendered to SOCTALK_LLM_TEMPERATURE.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "description": "Tenant-global default max output tokens for the router/supervisor tier. Rendered to SOCTALK_LLM_MAX_TOKENS. Capped at a router-appropriate ceiling \u2014 a schema-constrained decision is small.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "",
            "frontier",
            "openai_compatible",
            "vllm",
            "sglang"
          ]
        },
        "apiKeyRef": {
          "type": "object",
          "required": [
            "namespace",
            "name",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "apiKey": {
          "description": "Plaintext LLM API key. When non-empty the chart creates the Secret referenced by apiKeyRef in the release namespace; when empty the Secret must be pre-provisioned (legacy in-cluster mode). Passes through the AgentJob spec \u2014 same trust boundary as the agent runtime token.",
          "type": "string"
        },
        "secretChecksum": {
          "description": "sha256 of the LLM key material (primary + per-tier own keys), salted with the tenant id. Rendered as a runs-worker pod-template annotation (checksum/llm-secret) so a key-only rotation \u2014 which leaves the rest of the values byte-identical \u2014 still rolls the worker (env-from-secret does not hot-reload). Not a secret; a sha256 of a high-entropy key is not reversible.",
          "type": "string"
        },
        "tokenBudgetPerRun": {
          "description": "Per-tenant case-run token cap. Rendered to SOCTALK_CASE_RUN_TOKEN_BUDGET. Absent = the worker default.",
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "tiers": {
          "description": "Optional per-tier LLM backends for a hybrid tenant (issue #12). Absent = single-provider (the properties above). Each tier's provider/baseUrl/model/engine render to SOCTALK_<TIER>_* worker env; 'fast' maps to the runtime router tier, 'reasoning' to the reasoning tier. Served/gateway engine baseUrl checks here are pattern-based fail-fast guards; the API/Python invariant is authoritative.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fast": {
              "$ref": "#/$defs/llmTier"
            },
            "reasoning": {
              "$ref": "#/$defs/llmTier"
            }
          }
        },
        "tierKeys": {
          "description": "Plaintext per-tier API keys for tiers carrying their own credential (materialized as fast_api_key/reasoning_api_key data keys on the tenant-llm-key Secret). Empty string on the controller-owned Secret path, same as apiKey.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fast": {
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            }
          }
        }
      }
    },
    "soctalkSystem": {
      "description": "Cross-cluster reachability block. When the tenant's cluster is separate from the MSSP's SocTalk install (L2 on its own k3s, not a namespace inside the MSSP cluster), the adapter must reach L1 over the public URL with a bearer token minted by L1 at :issue-agent time.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "Full L1 API URL the adapter POSTs heartbeats + events to (e.g. https://l1.mssp.example). When set, overrides adapter.api.serviceHost/servicePort. Empty string disables the cross-cluster path (collapsed-tier mode).",
          "type": "string",
          "anyOf": [
            {
              "format": "uri"
            },
            {
              "maxLength": 0
            }
          ]
        },
        "adapterToken": {
          "description": "Plaintext JWT L1 minted for this tenant's adapter. Chart materializes this as the Secret named by adapter.tokenSecretRef.name.",
          "type": "string"
        },
        "hostAliases": {
          "description": "Pod-level /etc/hosts entries applied to the adapter + runs-worker deployments. Populated by the L1 controller when the tenant cluster can't resolve soctalkSystem.url via cluster DNS.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ip",
              "hostnames"
            ],
            "properties": {
              "ip": {
                "type": "string"
              },
              "hostnames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "verifySsl": {
          "description": "TLS verification for the adapter's connection to soctalkSystem.url (heartbeat + alert forwarding). Set false by the L1 controller when L1 serves a self-signed cert (launchpad demo / pending launchpad-owned certs). Absent leaves verification on.",
          "type": "boolean"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wazuh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "manager": {
              "$ref": "#/$defs/componentBlock"
            },
            "indexer": {
              "allOf": [
                {
                  "$ref": "#/$defs/componentBlock"
                },
                {
                  "type": "object",
                  "properties": {
                    "jvm": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "heap": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "dashboard": {
              "$ref": "#/$defs/componentBlock"
            }
          }
        },
        "thehive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "cassandra": {
              "$ref": "#/$defs/componentBlock"
            }
          }
        },
        "cortex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "elasticsearch": {
              "$ref": "#/$defs/componentBlock"
            },
            "analyzers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "misp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "linuxep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "linux-ep simulator subchart gate. Only 'poc' profile installs it; false for 'persistent' + 'provided'."
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedLlmHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "llmEgressPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "TCP port the runs-worker egress policy opens for outbound LLM calls. Controller-derived from the LLM base URL (443 https / 80 http / explicit port) so self-hosted endpoints on non-standard ports aren't blocked."
        },
        "extraLlmEgressPorts": {
          "description": "Additional distinct LLM egress ports opened for the runs-worker when per-tier backends (llm.tiers) use ports other than llmEgressPort (issue #12). Empty/absent for single-provider tenants.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "externalSiemHosts": {
          "description": "FQDNs of the externally-provided Wazuh indexer + API the adapter must reach (deduped). Populated for the 'provided' profile; empty for in-cluster profiles. Feeds the Cilium FQDN egress allow-list (matchName entries). Items are bare hostnames \u2014 no scheme, no port.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
          }
        },
        "fqdnEgress": {
          "description": "Emit a CiliumNetworkPolicy permitting adapter egress to soctalkSystem.url and the externalSiemHosts FQDNs. Requires Cilium CRDs.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "persistentVolumeClaims": {
          "type": "string"
        },
        "pods": {
          "type": "string"
        }
      }
    },
    "limitRange": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaults": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "defaultRequests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "max": {
          "$ref": "#/$defs/resourceQuantities"
        }
      }
    },
    "agentIngress": {
      "type": "object",
      "required": [
        "hostname"
      ],
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "format": "hostname"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerRef": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "required": [
        "image",
        "resources",
        "tokenSecretRef",
        "api"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "api": {
          "type": "object",
          "required": [
            "serviceHost",
            "servicePort"
          ],
          "additionalProperties": false,
          "properties": {
            "serviceHost": {
              "type": "string",
              "minLength": 1
            },
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "tokenSecretRef": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "readinessProbe": {
          "type": [
            "object",
            "null"
          ]
        },
        "wazuhIndexer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "credsSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            },
            "verifySsl": {
              "type": "boolean"
            },
            "minSeverity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          }
        }
      }
    },
    "namespaceLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runsWorker": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "resources",
        "tokenSecretRef"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "tokenSecretRef": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "token": {
          "type": "string",
          "description": "Optional plaintext JWT used by the cross-cluster L2 path; chart materializes tokenSecretRef from this value when non-empty."
        },
        "fastModel": {
          "type": "string"
        },
        "reasoningModel": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent in-flight investigations per runs-worker process (issue #61). >1 lets a shared self-hosted vLLM/SGLang backend fill its continuous batch (runs execute concurrently, each an independent claim under FOR UPDATE ... SKIP LOCKED). Bound by the backend's max_inputs and KV-cache/VRAM. Rendered as WORKER_RUN_CONCURRENCY only when >1, so the default (1) render is byte-identical to the pre-change chart."
        },
        "drainSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds to let in-flight runs finish on SIGTERM before cancelling stragglers (the server-side lease reaper requeues any cancelled run). Rendered as WORKER_DRAIN_SECONDS only when concurrency >1."
        },
        "triagePolicies": {
          "type": "object",
          "description": "Declarative triage-policy files (issue #44): filename -> YAML content string. Rendered as ConfigMap soctalk-triage-policies, mounted read-only into the runs-worker, with SOCTALK_TRIAGE_POLICY_DIR pointing at the mount. Content is validated fail-closed by the worker's registry loader at startup (and again by render.py on the controller path); files default to status: shadow until explicitly activated. Empty map (default) renders nothing.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$",
            "maxLength": 253
          },
          "maxProperties": 32
        },
        "wazuh": {
          "type": "object",
          "description": "Wazuh MCP enrichment wiring for the triage graph (issue #109). apiUrl -> WAZUH_URL (manager REST :55000); indexerHost/indexerPort -> the MCP indexer client; credsSecret holds WAZUH_API_USERNAME/WAZUH_API_PASSWORD/INDEXER_USERNAME/INDEXER_PASSWORD (same key layout in wazuh-<slug>-wazuh-creds and tenant-external-siem-creds). Populated per profile by render.py; disabled by default.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiUrl": {
              "type": "string",
              "maxLength": 500
            },
            "indexerHost": {
              "type": "string",
              "maxLength": 253
            },
            "indexerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "credsSecret": {
              "type": "string",
              "maxLength": 253
            },
            "verifySsl": {
              "type": "boolean"
            }
          }
        },
        "demoTiSeeding": {
          "type": "boolean",
          "description": "Demo/lab only synthetic threat-intel seeding (see values.yaml). Was set in values.yaml but missing here; helm >= 3.15 validates coalesced defaults against this schema, so the omission fails every render."
        },
        "playbooks": {
          "type": "object",
          "description": "DEPRECATED alias of triagePolicies, accepted for one release. Same shape and semantics.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$",
            "maxLength": 253
          },
          "maxProperties": 32
        }
      }
    }
  },
  "$defs": {
    "llmTier": {
      "type": "object",
      "required": [
        "provider",
        "baseUrl",
        "model"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "provider",
              "engine"
            ],
            "properties": {
              "provider": {
                "const": "anthropic"
              },
              "engine": {
                "enum": [
                  "openai_compatible",
                  "vllm",
                  "sglang"
                ]
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "engine"
            ],
            "properties": {
              "engine": {
                "enum": [
                  "openai_compatible",
                  "vllm",
                  "sglang"
                ]
              }
            },
            "anyOf": [
              {
                "not": {
                  "required": [
                    "baseUrl"
                  ]
                }
              },
              {
                "required": [
                  "baseUrl"
                ],
                "properties": {
                  "baseUrl": {
                    "pattern": "^\\s*(?:$|[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^@/?#\\s]+@)?api\\.(?:openai|anthropic)\\.com(?::[0-9]+)?(?:[/\\?#].*)?)\\s*$"
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Per-tier LLM base URL. For served/gateway engines, the schema rejects common hosted OpenAI/Anthropic API forms after trimming whitespace as a fail-fast approximation; the API/Python invariant is authoritative."
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "",
            "frontier",
            "openai_compatible",
            "vllm",
            "sglang"
          ]
        },
        "decodingMode": {
          "enum": [
            "auto",
            "none",
            "tool_use",
            "json_schema_strict",
            "json_object",
            "guided_json",
            "guided_grammar"
          ]
        },
        "temperature": {
          "description": "Per-tier sampling temperature override. Rendered to SOCTALK_<TIER>_TEMPERATURE.",
