{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soctalk/soctalk/charts/soctalk-system/values.schema.json",
  "title": "SocTalk System Chart Values",
  "description": "Validation schema for soctalk-system Helm chart values.",
  "type": "object",
  "required": [
    "install",
    "image",
    "postgres",
    "ingress",
    "oidc",
    "defaults",
    "resources",
    "admission",
    "licensing",
    "telemetry",
    "rbac"
  ],
  "additionalProperties": false,
  "properties": {
    "install": {
      "type": "object",
      "required": [
        "msspId",
        "msspName",
        "installId"
      ],
      "additionalProperties": false,
      "properties": {
        "msspId": {
          "type": "string",
          "format": "uuid"
        },
        "msspName": {
          "type": "string",
          "minLength": 1
        },
        "installId": {
          "type": "string",
          "format": "uuid"
        },
        "installLabel": {
          "type": "string"
        },
        "msspSlug": {
          "type": "string",
          "description": "Public slug for this MSSP install. Used as the leftmost label in <slug>.<base-domain>. If empty, the chart slugifies msspName at bootstrap."
        },
        "bootstrapAdmin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "registry",
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "controllerNamespace": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "issuerRef": {
              "type": "string"
            }
          }
        },
        "hostnames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mssp": {
              "type": "string"
            },
            "customer": {
              "type": "string"
            }
          }
        },
        "tenantWildcard": {
          "type": "string"
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustedHeaderUser": {
          "type": "string"
        },
        "trustedHeaderEmail": {
          "type": "string"
        },
        "trustedHeaderGroups": {
          "type": "string"
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runTokenBudget": {
          "type": "object",
          "additionalProperties": false,
          "description": "Install hard cap for the per-tenant run token budget override (#103).",
          "properties": {
            "max": {
              "type": [
                "integer",
                "string"
              ],
              "description": "Ceiling a tenant override may not exceed. Empty = API default."
            }
          }
        },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "provider",
                  "engine"
                ],
                "properties": {
                  "provider": {
                    "const": "anthropic"
                  },
                  "engine": {
                    "enum": [
                      "openai_compatible",
                      "vllm",
                      "sglang"
                    ]
                  }
                }
              }
            },
            {
              "not": {
                "required": [
                  "engine"
                ],
                "properties": {
                  "engine": {
                    "enum": [
                      "openai_compatible",
                      "vllm",
                      "sglang"
                    ]
                  }
                },
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "baseUrl"
                      ]
                    }
                  },
                  {
                    "required": [
                      "baseUrl"
                    ],
                    "properties": {
                      "baseUrl": {
                        "$ref": "#/$defs/hostedVendorServedBaseUrl"
                      }
                    }
                  }
                ]
              }
            }
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai-compatible",
                "openai",
                "anthropic",
                "azure",
                "ollama"
              ],
              "description": "Install-wide default LLM provider. Fed into SOCTALK_LLM_PROVIDER_DEFAULT on the api; the onboard endpoint uses it as fallback when the wizard doesn't specify a per-tenant provider."
            },
            "baseUrl": {
              "type": "string",
              "format": "uri",
              "description": "Install-wide default LLM base URL. For served/gateway engines, the schema rejects common hosted OpenAI/Anthropic API forms after trimming whitespace as a fail-fast approximation; the API/Python invariant is authoritative."
            },
            "model": {
              "type": "string"
            },
            "fastTier": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional install-wide default FAST (router) tier injected into every newly onboarded tenant's llm_tiers (hybrid: router on this backend, reasoning on the primary provider). Consumed by tenants.py::_install_default_llm_tiers. The API key rides an out-of-band Secret via apiKeySecret \u2014 never put it in values. Served/gateway engine baseUrl checks here are pattern-based fail-fast guards; the API/Python invariant is authoritative.",
              "allOf": [
                {
                  "not": {
                    "required": [
                      "provider",
                      "engine"
                    ],
                    "properties": {
                      "provider": {
                        "const": "anthropic"
                      },
                      "engine": {
                        "enum": [
                          "openai_compatible",
                          "vllm",
                          "sglang"
                        ]
                      }
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "engine"
                    ],
                    "properties": {
                      "engine": {
                        "enum": [
                          "openai_compatible",
                          "vllm",
                          "sglang"
                        ]
                      }
                    },
                    "anyOf": [
                      {
                        "not": {
                          "required": [
                            "baseUrl"
                          ]
                        }
                      },
                      {
                        "required": [
                          "baseUrl"
                        ],
                        "properties": {
                          "baseUrl": {
                            "$ref": "#/$defs/hostedVendorServedBaseUrl"
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "properties": {
                "provider": {
                  "enum": [
                    "openai-compatible",
                    "anthropic"
                  ]
                },
                "baseUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "FAST tier base URL. For served/gateway engines, the schema rejects common hosted OpenAI/Anthropic API forms after trimming whitespace as a fail-fast approximation; the API/Python invariant is authoritative."
                },
                "model": {
                  "type": "string"
                },
                "engine": {
                  "enum": [
                    "",
                    "frontier",
                    "openai_compatible",
                    "vllm",
                    "sglang"
                  ]
                },
                "decodingMode": {
                  "enum": [
                    "auto",
                    "none",
                    "tool_use",
                    "json_schema_strict",
                    "json_object",
                    "guided_json",
                    "guided_grammar"
                  ]
                },
                "apiKeySecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "engine": {
              "type": "string",
              "enum": [
                "",
                "frontier",
                "openai_compatible",
                "vllm",
                "sglang"
              ],
              "description": "Serving engine behind baseUrl when SocTalk prices it separately. Empty for a hosted vendor or generic gateway."
            }
          }
        },
        "runDollarBudget": {
          "type": "object",
          "additionalProperties": false,
          "description": "Install hard cap for the per-tenant per-run dollar budget override (#128).",
          "properties": {
            "max": {
              "type": [
                "number",
                "string"
              ],
              "description": "Ceiling a tenant override may not exceed. Empty = API default."
            }
          }
        },
        "budgetDayTimezone": {
          "type": "string",
          "description": "IANA zone whose midnight resets the daily spend ceilings (#129). Empty = UTC. Tenants may override it in policy."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "$ref": "#/$defs/componentResources"
        },
        "appUi": {
          "$ref": "#/$defs/componentResources"
        },
        "orchestrator": {
          "$ref": "#/$defs/componentResources",
          "description": "Deprecated \u2014 the legacy SecOpsOrchestrator pod was retired (per-tenant runs-worker replaces it). Accepted in the schema so existing values files / --reuse-values upgrades from the prior chart still validate; chart templates ignore the value."
        }
      }
    },
    "admission": {
      "type": "object",
      "required": [
        "engine"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "vap",
            "none"
          ]
        }
      }
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "allowClusterNamespaceOps": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cilium": {
          "type": "boolean"
        }
      }
    },
    "preInstallCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "anthropic",
            "openai"
          ]
        },
        "apiKey": {
          "type": "string"
        }
      }
    },
    "tenantProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantChartRef": {
          "type": "string"
        },
        "tenantChartVersion": {
          "type": "string"
        },
        "agentChartRef": {
          "type": "string",
          "description": "OCI ref for the soctalk-cloud-agent chart the tenant admin helm-installs after :issue-agent. Mirrors tenantChartRef \u2014 override to point at a lab / staging OCI mirror when validating a pilot."
        },
        "agentChartVersion": {
          "type": "string"
        },
        "helmPlainHttp": {
          "type": "boolean",
          "description": "Force --plain-http on the api's sync helm SDK for lab OCI registries served over HTTP. Off by default."
        },
        "l1HostAliases": {
          "type": "string",
          "description": "Install-wide pod-level /etc/hosts entries baked into every new tenant install. Semicolon-list of ``ip=host[,host]`` pairs. Empty when the MSSP is reachable via cluster / cloud DNS."
        },
        "l1VerifySsl": {
          "type": "string",
          "description": "Install-wide TLS-verify hint for the tenant adapter's connection back to this MSSP. Set to \"false\" when the MSSP serves a self-signed cert so tenant adapters can heartbeat + forward alerts. Empty for a production CA-signed MSSP (verify on)."
        },
        "wazuhChartPath": {
          "type": "string"
        },
        "persistentStorageClass": {
          "type": "string",
          "description": "StorageClass the 'persistent' Wazuh profile provisions manager + indexer PVCs from. Checked at provisioning preflight and pushed into the wazuh chart's storage.storageClass. 'standard' is the GKE/minikube convention; K3s ships 'local-path'. Empty falls back to 'standard' - it does not mean 'cluster default'."
        },
        "adapterImageRepo": {
          "type": "string"
        },
        "adapterImageTag": {
          "type": "string"
        },
        "runsWorkerImageRepo": {
          "type": "string"
        },
        "runsWorkerImageTag": {
          "type": "string"
        },
        "linuxEpImageTag": {
          "type": "string"
        },
        "tenantNetworkPoliciesEnabled": {
          "type": "boolean"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cookieSecure": {
          "type": "boolean"
        },
        "publicOriginOverride": {
          "type": "string",
          "description": "Comma-separated SOCTALK_PUBLIC_ORIGIN override for CSRF. Set when the browser's origin includes a non-standard port (e.g. local k3d :8080). Empty means derive from ingress.hostnames."
        }
      }
    }
  },
  "$defs": {
    "hostedVendorServedBaseUrl": {
      "pattern": "^\\s*(?:$|[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^@/?#\\s]+@)?[aA][pP][iI][.\u3002\uff0e\uff61](?:[oO][pP][eE][nN][aA][iI]|[aA][nN][tT][hH][rR][oO][pP][iI][cC])[.\u3002\uff0e\uff61][cC][oO][mM](?::[0-9]+)?(?:[/\\?#].*)?)\\s*$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        }
      }
    },
    "componentResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    }
  }
}
